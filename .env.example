# Copy to .env locally. Never commit .env or paste credentials into chat.
# Setup mode is accepted ONLY by the development server. Production requires Supabase.
RIMBAGUARD_SETUP_MODE=true

# All reusable credentials stay on the server, including the Supabase anon key.
# This deliberately replaces the PRD's NUXT_PUBLIC_SUPABASE_ANON_KEY naming.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required when Phase 3 is connected; never a public runtime setting.
GEMINI_API_KEY=
GEMINI_MODEL=

NUXT_PUBLIC_APP_URL=http://localhost:3000

# Hosts may alternatively use Nuxt's runtime names:
# NUXT_SUPABASE_URL, NUXT_SUPABASE_ANON_KEY, NUXT_SUPABASE_SERVICE_ROLE_KEY,
# NUXT_GEMINI_API_KEY, NUXT_GEMINI_MODEL. All remain private runtime fields.
